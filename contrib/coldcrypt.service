[Unit]
Description=Coldcrypt encrypted backup manager
Documentation=https://github.com/seanmatheny/coldcrypt
After=network.target

[Service]
Type=simple
# Run as a dedicated user for isolation. Create with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin coldcrypt
User=coldcrypt
Group=coldcrypt

# Adjust these paths to match your installation.
ExecStart=/usr/local/bin/coldcrypt serve --config /etc/coldcrypt/config.json --secrets-config /etc/coldcrypt/secrets.json

Restart=on-failure
RestartSec=10

# Give the service permission to read source directories and write the data
# directory. The config file and data dir must be owned/readable by the
# coldcrypt user:
#   sudo chown -R coldcrypt:coldcrypt /etc/coldcrypt /var/lib/coldcrypt
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coldcrypt

# Harden the service where possible.
NoNewPrivileges=true
# ProtectSystem=strict remounts most of the host filesystem read-only for the
# service. Only StateDirectory=/LogsDirectory= and paths listed in
# ReadWritePaths= remain writable. This affects restores too: restoring into
# arbitrary locations like /Restore will fail with EROFS unless they are added
# to ReadWritePaths= below.
ProtectSystem=strict
# StateDirectory and LogsDirectory create /var/lib/coldcrypt and
# /var/log/coldcrypt (owned by the service user) and implicitly add them to
# ReadWritePaths, so no explicit ReadWritePaths entry is needed for them.
StateDirectory=coldcrypt
LogsDirectory=coldcrypt
ReadOnlyPaths=/etc/coldcrypt
# Uncomment and list the directories you are backing up so the service can
# read them. Example:
# ReadOnlyPaths=/home /srv/data
# Add writable restore destinations here if you need to restore outside the
# state/log directories. Example:
# ReadWritePaths=/Restore /mnt/restore-target

[Install]
WantedBy=multi-user.target
